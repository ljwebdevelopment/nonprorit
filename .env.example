# Copy to .env.local and fill in once real backends exist.
# Until these are set, forms fall back to a friendly placeholder message
# and log the submission payload to the console.

VITE_ORG_EMAIL=hello@sproutfundok.org

# Endpoint that accepts a POSTed grant application (JSON body, see
# GrantApplicationPayload in src/types/index.ts).
VITE_GRANT_APPLICATION_WEBHOOK_URL=

# Endpoint that accepts a POSTed contact/support message (JSON body, see
# ContactPayload in src/types/index.ts).
VITE_CONTACT_WEBHOOK_URL=
